{
  "name": "@maxwellmezadre/btgpactual-mcp",
  "version": "0.1.0",
  "description": "CLI + servidor MCP para a sua conta no BTG Pactual (conta corrente, cartões, faturas, investimentos, open finance e câmbio) sobre um núcleo compartilhado",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxwellmezadre/btgpactual-mcp.git"
  },
  "homepage": "https://github.com/maxwellmezadre/btgpactual-mcp#readme",
  "keywords": [
    "btg",
    "btgpactual",
    "cli",
    "mcp",
    "banking",
    "investments",
    "finance",
    "claude"
  ],
  "bin": {
    "btgpactual": "dist/bin.js",
    "btgpactual-mcp": "dist/mcp-bin.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "docs/TOOLS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": "./dist/bin.js",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "start": "bun run src/bin.ts",
    "login": "bun run src/bin.ts login",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run scripts/verify.ts",
    "docs:tools": "bun run scripts/gen-tools-doc.ts",
    "build:dist": "bun build src/bin.ts src/mcp-bin.ts --target=bun --packages external --outdir dist",
    "build:binary": "bun build --compile --external chromium-bidi src/bin.ts --outfile btgpactual",
    "prepublishOnly": "bun run build:dist",
    "setup": "bun run scripts/install.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sinclair/typebox": "^0.34.52",
    "commander": "^15.0.0",
    "node-html-parser": "^9.0.4",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "typescript": "^5"
  }
}
